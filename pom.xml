<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.portfolio</groupId>
    <artifactId>jogo-snake</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Jogo Snake - Portfolio Java</name>
    <description>Snake do portfolio: núcleo sem Swing, borda mata ou dá a volta, skins por código com sprites opcionais</description>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <main.class>com.portfolio.snake.ui.TelaSnake</main.class>
        <logo.ico>${project.basedir}/src/main/resources/logo.ico</logo.ico>
        <exe.file.version>1.0.0.0</exe.file.version>
        <exe.product.version>1.0.0.0</exe.product.version>
        <exe.version.text>1.0</exe.version.text>
    </properties>

    <dependencies>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>${maven.compiler.source}</source>
                    <target>${maven.compiler.target}</target>
                    <encoding>${project.build.sourceEncoding}</encoding>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>${main.class}</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.1.2</version>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.akathist.maven.plugins.launch4j</groupId>
                <artifactId>launch4j-maven-plugin</artifactId>
                <version>2.7.0</version>
                <executions>
                    <execution>
                        <id>l4j-gui</id>
                        <phase>package</phase>
                        <goals>
                            <goal>launch4j</goal>
                        </goals>
                        <configuration>
                            <headerType>gui</headerType>
                            <outfile>${project.build.directory}/jogo-snake.exe</outfile>
                            <jar>${project.build.directory}/${project.build.finalName}.jar</jar>
                            <icon>${logo.ico}</icon>
                            <errTitle>Jogo Snake</errTitle>
                            <downloadUrl>https://www.adoptium.net/</downloadUrl>
                            <disableVersionInfoDefaults>true</disableVersionInfoDefaults>
                            <classPath>
                                <mainClass>${main.class}</mainClass>
                                <addDependencies>false</addDependencies>
                            </classPath>
                            <jre>
                                <path>%JAVA_HOME%;%PATH%</path>
                                <minVersion>17.0.0</minVersion>
                            </jre>
                            <versionInfo>
                                <fileVersion>${exe.file.version}</fileVersion>
                                <txtFileVersion>${exe.version.text}</txtFileVersion>
                                <fileDescription>Jogo Snake</fileDescription>
                                <copyright>Copyright (c) 2026 Eduardo Alves</copyright>
                                <productVersion>${exe.product.version}</productVersion>
                                <txtProductVersion>${exe.version.text}</txtProductVersion>
                                <productName>Jogo Snake</productName>
                                <internalName>jogo-snake</internalName>
                                <originalFilename>jogo-snake.exe</originalFilename>
                            </versionInfo>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
